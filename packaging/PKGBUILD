# Maintainer: Cristian Moraru <info@thekrystalship.com>
#
# Build from this directory:  cd packaging && makepkg
#
# Compiles nothing. CI publishes first and this places the result, so the packaged bytes are the
# tested bytes. Point KGSM_STAGE at that publish output, or leave it unset to use
# ../artifacts/publish, which is where deploy.sh leaves one.
#
# The install prefix stays /opt/kgsm-reactor, the same path deploy.sh uses on a development host, so
# the systemd unit is byte-identical whether it came from a package or a deploy. A unit rewritten at
# packaging time is a unit nobody tested.

pkgname=kgsm-reactor
pkgver=0.1.0
pkgrel=1
pkgdesc="KGSM reactor — watches every component's event journal and records what happened"
arch=('x86_64')
url="https://github.com/TheKrystalShip/kgsm-reactor"
license=('GPL-3.0-or-later')
groups=('kgsm-node')
# No separate debug package: these are shipped to a private fleet, not a distro archive.
options=('!debug')
depends=('kgsm' 'systemd' 'glibc')
# The producers of the events worth observing. Absent, the reactor runs and simply sees nothing of
# that kind — it depends on neither to start.
optdepends=('kgsm-watchdog: produces the crash, give-up and player events'
            'kgsm-monitor: produces the host threshold episodes')
backup=('etc/kgsm-reactor/kgsm-reactor.env')

_stage() { printf '%s' "${KGSM_STAGE:-${startdir}/../artifacts/publish}"; }

pkgver() {
    "${startdir}/../deploy/version.sh" --pkgver
}

build() {
    local stage; stage="$(_stage)"
    [[ -e "${stage}/kgsm-reactor" ]] || {
        printf '\n  no publish output at %s\n' "$stage" >&2
        printf '  build it first:  dotnet publish src/Reactor/Reactor.csproj -c Release -r linux-x64 -o artifacts/publish\n' >&2
        printf '  or point KGSM_STAGE at an existing one.\n\n' >&2
        return 1
    }
}

package() {
    local repo="${startdir}/.." stage; stage="$(_stage)"
    local prefix="${pkgdir}/opt/kgsm-reactor"

    install -dm755 "$prefix"
    # -a keeps the executable bit on libe_sqlite3.so, which the AOT publish emits beside the binary.
    cp -a "${stage}/." "${prefix}/"
    # Debug artifacts a published tree carries and a package should not.
    rm -f "${prefix}"/*.pdb "${prefix}"/*.dbg

    install -Dm644 "${repo}/deploy/kgsm-reactor.service" \
        "${pkgdir}/usr/lib/systemd/system/kgsm-reactor.service"
    install -Dm644 "${repo}/deploy/sysusers.d/kgsm-reactor.conf" \
        "${pkgdir}/usr/lib/sysusers.d/kgsm-reactor.conf"

    # Seeded from the committed example and listed in backup=(), so an upgrade writes .pacnew beside
    # a file you edited rather than over it.
    install -Dm640 "${repo}/deploy/kgsm-reactor.env.example" \
        "${pkgdir}/etc/kgsm-reactor/kgsm-reactor.env"

    # The leaf config descriptor, in the directory kgsm-api scans. Packaged rather than installed by
    # a script, so it can never describe a different build than the one beside it.
    install -Dm644 "${repo}/deploy/kgsm-reactor.leaf.json" \
        "${pkgdir}/var/lib/kgsm/leaves/reactor.json"
    install -Dm644 "${repo}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
