{
  // === KGSM Reactor — configuration ===
  //
  // This file declares the daemon's WHOLE configurable surface, each key with its default. It is
  // the floor; an environment variable overrides one key of it by spelling that key's path with
  // "__" — Reactor__RetentionDays, Logging__LogLevel__Default. A variable naming a key that is not
  // declared here binds to nothing.
  //
  // Every key below maps 1:1 onto a property of ReactorSettings, which the daemon binds in one
  // step. A test fails the build if the two ever disagree, in either direction.

  "Reactor": {
    // Whether the reactor observes at all. False leaves the daemon running and recording nothing,
    // which is how to silence it without stopping the service — and it still reports leaf_ready,
    // so a host can tell "deliberately quiet" from "broken".
    "Enabled": true,

    // Path to the KGSM executable. Nothing in the observing half calls it; re-reading the world
    // before deciding anything does. Checked at startup so a host where this is wrong fails now
    // rather than at the moment it matters.
    "KgsmPath": "/usr/bin/kgsm",

    // Where the engine's own event journal lives. Every other producer's journal is discovered by
    // scanning state directories; the engine's is the one that has to be named.
    "JournalDir": "/var/lib/kgsm/events",

    // Where each producer's state directory lives, each holding its journal in an "events"
    // subdirectory. Blank uses the ecosystem default (/var/lib).
    "StateRoot": "",

    // The observation ledger. Blank resolves to reactor.db inside the systemd state directory
    // ($STATE_DIRECTORY, /var/lib/kgsm-reactor), which is where it belongs on a real host.
    "LedgerPath": "",

    // How long an observation is kept, in days. The ledger is DERIVED — every row restates a line
    // still held in some producer's own journal — so pruning it loses no record. What it costs is
    // how far back the reactor can measure its own windows.
    "RetentionDays": 30,

    // How often buffered observations are committed, in seconds. They are batched rather than
    // written one transaction per event: a busy evening is hundreds of player events an hour and
    // this daemon must not be why the host's disk is busy.
    "FlushIntervalSeconds": 5,

    // The watchdog's control socket. Every rule re-derives from the live world before deciding, and
    // the supervisor is the authority on whether a native instance is running. Unreachable reads as
    // "cannot tell" and stops the evaluation — never as "the condition does not hold".
    "WatchdogSocketPath": "/run/kgsm-watchdog/control.sock",

    // The monitor's metrics socket. Read for what each instance has been MEASURED to hold, which no
    // event carries and no other component can answer. The monitor is a leaf: absent or unreachable,
    // the one rule that reads it reports "cannot tell" and nothing else about this daemon changes.
    "MonitorSocketPath": "/run/kgsm-monitor/metrics.sock",

    // The unix socket the status endpoint listens on. A socket rather than a port: nothing off this
    // host has business asking a leaf what it is thinking, and the filesystem permissions are the
    // whole boundary. It lives in the systemd runtime directory, so it is created on start and gone
    // on stop and a stale file can never look like a running reactor.
    "StatusSocketPath": "/run/kgsm-reactor/status.sock",

    // Permission bits set on that socket, as an OCTAL STRING. Quoted because a leading zero is not
    // legal JSON and an unquoted 660 would be read as decimal — a different mode entirely.
    "StatusSocketMode": "660",

    // How often rules are evaluated, in seconds.
    "SweepIntervalSeconds": 30,

    // How long one rule stays quiet about one subject after firing, in minutes. The host-wide
    // fallback, measured from the spacing between repeat events for one subject: a crash repeats
    // every 25s at p50, which this covers comfortably. A rule whose waking event repeats on a
    // different scale carries its own window in the rule table and ignores this — `/status` reports
    // each rule's window as resolved, which is the one that is actually in force.
    "SuppressionWindowMinutes": 30,

    // The most decisions that may fire host-wide in a rolling hour. Zero disables the ceiling.
    // Counted in DECISIONS, not events, and the two differ by a lot: the busiest hour measured held
    // 36 events a rule wakes on but across only 4 subjects, because most of it was one server
    // crash-looping and suppression collapses that to one decision. This covers the whole fleet
    // failing at once with room for host sensors beside it — a host that lost every server is the
    // story a ceiling most needs to let through, not the one it should cut off.
    "MaxActionsPerHour": 12,

    // Where the rules this host runs are read from. Blank resolves to rules.json inside the systemd
    // state directory ($STATE_DIRECTORY, /var/lib/kgsm-reactor). A MISSING FILE IS THE ORDINARY CASE:
    // the host then runs the rules this build seeds, every one of them observing, which is the state
    // a rule has to earn its way out of.
    //
    // A rule is data assembled from the catalogs on /catalog: what wakes it, what subjects it decides
    // about, an ordered list of steps over signals this build can measure, and one of the actions it
    // can perform. Its mode — off, observe, propose, act — is a field on the rule.
    //
    // Read ONCE, at startup. A rule naming a signal this build does not measure, saying something it
    // never binds, judged the instant its event lands, or sharing an id with another rule is left out
    // and reported on /status — the rest of the file still runs. "I saved it and nothing happened" is
    // the one outcome this must never produce.
    "RulesPath": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
