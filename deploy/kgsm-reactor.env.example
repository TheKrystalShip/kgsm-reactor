# kgsm-reactor — configuration (systemd EnvironmentFile format: KEY=VALUE, # comments).
#
# Copy to /etc/kgsm-reactor/kgsm-reactor.env, edit, and reference it from the unit with
#   EnvironmentFile=-/etc/kgsm-reactor/kgsm-reactor.env
#
# kgsm-reactor.settings.json, installed beside the binary, declares every knob with its default.
# A variable here overrides ONE key of that file, spelling its path with "__". A variable naming a
# key the file does not declare binds to nothing, so check the spelling against that file.
#
# Defaults are shown in [brackets]; uncomment a line only to override one.

# ── General ───────────────────────────────────────────────────────────────────
# Whether the reactor observes at all. False leaves the daemon running and recording nothing —
# how to silence it without stopping the service.                                     [true]
#Reactor__Enabled=true

# ── Connections ───────────────────────────────────────────────────────────────
# Path to the KGSM executable. Checked at startup — the daemon refuses to run if nothing is
# there, because a reactor that cannot re-read the world cannot decide anything.
#                                                                            [/usr/bin/kgsm]
#Reactor__KgsmPath=/usr/bin/kgsm

# Where the engine's own event journal lives. Every other producer's journal is discovered by
# scanning state directories; the engine's is the one that has to be named.
#                                                                      [/var/lib/kgsm/events]
#Reactor__JournalDir=/var/lib/kgsm/events

# Where each component's state directory lives, each holding its journal in an "events"
# subdirectory. Blank uses the ecosystem default.                              [/var/lib]
#Reactor__StateRoot=

# The observation ledger. Blank keeps it in this service's own state directory, which is what a
# normal install wants.                                       [$STATE_DIRECTORY/reactor.db]
#Reactor__LedgerPath=

# ── Observations ──────────────────────────────────────────────────────────────
# How long an observation is kept, in days. The ledger is derived working data, not a record:
# every row restates a line still held in some producer's own journal.                  [30]
#Reactor__RetentionDays=30

# How often buffered observations are committed (seconds). Longer means fewer, larger writes.
#                                                                                       [5]
#Reactor__FlushIntervalSeconds=5

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum severity logged, to the journal.                                    [Information]
#Logging__LogLevel__Default=Information
